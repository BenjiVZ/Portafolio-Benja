# ── Supabase ──
# De tu proyecto en supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publicable_aqui

# ── Clave del panel /admin ──
# ATENCIÓN: Vite incrusta las variables VITE_* en el bundle que descarga el
# navegador. Esta clave es LEGIBLE con las devtools: solo evita accesos
# casuales, no es seguridad real.
# Quien protege los datos son las políticas RLS de Supabase.
VITE_ADMIN_PASSWORD=cambia_esta_clave

# En Vercel: Settings → Environment Variables (hay que redesplegar al cambiarlas).
# Los repos de GitHub no van en Supabase: se editan en src/data/repos-github.json
